# Copy this file to .env and fill it in. Never commit .env.

# From https://developer.spotify.com/dashboard -> your app -> Settings
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must match a Redirect URI in the Spotify dashboard EXACTLY.
# Locally Spotify requires 127.0.0.1 (not "localhost").
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/auth/callback

# Optional locally. Without it, lyrics are cached in memory and the Spotify
# token is kept in .data/ so you don't have to log in after every restart.
DATABASE_URL=

# Long random strings. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
SESSION_SECRET=
# Protects /auth/login (use: /auth/login?key=ADMIN_KEY)
ADMIN_KEY=
# Protects the display and API (open the page as /?t=DISPLAY_TOKEN)
DISPLAY_TOKEN=

# PORT=3000
